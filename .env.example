# Project name (namespaces containers and volumes, e.g. headless-wp-starter-wordpress-1)
COMPOSE_PROJECT_NAME=headless-wp-starter

# Database (MariaDB)
DB_ROOT_PASSWORD=rootpassword
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress

# WordPress
WP_PORT=8080

# Next.js
WEB_PORT=3000
NEXT_PUBLIC_WORDPRESS_URL=http://wordpress:80

# GHCR image owner (used in docker-compose.prod.yml)
GHCR_OWNER=

# Domains (prod only — used by Caddy for reverse proxy and Let's Encrypt)
WEB_DOMAIN=web.example.com
CMS_DOMAIN=cms.example.com

# WordPress admin (used by wp-init.sh on first install)
WP_TITLE=My Site
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# Grafana (monitoring)
GRAFANA_DOMAIN=grafana.example.com
GRAFANA_PASSWORD=

# Docker image tag (set by CI/CD, defaults to latest)
# IMAGE_TAG=latest

# Site URL (canonical, used for sitemap/RSS)
SITE_URL=https://web.example.com

# Preview (WordPress → Next.js draft mode)
PREVIEW_SECRET=
WORDPRESS_AUTH_TOKEN=

# Cloudflare R2 (used by backup container)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=my-backup
